echo PRE_PTRACE_KERNEL_BEGIN; if test -x /simulation/kernel-log-read; then L
D_BIND_NOW=1 /simulation/kernel-log-read; fi; cat /proc/sys/kernel/core_pattern;
 for t in /proc/$(pidof im.elf)/task/*; do case "$(cat "$t/comm")" in SeqQueueCo
mmon|SeqQueueDispSwi|CameraBackgroun|AppFw) echo KERNEL_THREAD "$t" "$(cat "$t/c
omm")"; cat "$t/wchan" "$t/stack" "$t/syscall" "$t/stat";; esac; done; echo PRE_
PTRACE_KERNEL_END; rc=$?; printf '\nA7M4_COMMAND_DONE_e37b78909f6a456b02b8ea5b:%
s\n' "$rc"
