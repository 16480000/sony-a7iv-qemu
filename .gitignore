# Python caches and temporary files
__pycache__/
*.py[cod]
*.tmp
*.swp
.DS_Store
Thumbs.db

# Local firmware, partition images and generated boot artifacts
/outputs/sony-a7iv-qemu/images/
/outputs/sony-a7iv-qemu/source/System.map
*.cpio
*.cpio.gz
*.ext2
*.vfat
*.qcow2
*.dtb
BODYDATA.DAT

# Runtime logs; frozen evidence snapshots remain versioned
*.log
/outputs/sony-a7iv-qemu/logs/
!/outputs/sony-a7iv-qemu/native/evidence/*.log

# Scratch screenshots (accepted screenshots live under outputs/)
/work/sony-a7iv/*.png
/work/sony-a7iv/*.ppm

# Local environment and private credentials
.env
.env.*
*.pem
*.key

# Host-generated virtual sensor inputs and personal media
/work/sony-a7iv/sample-video.mp4
/work/sony-a7iv/virtual-photo*.jpg
/work/sony-a7iv/*.rgb4444
/work/sony-a7iv/virtual-video.meta
/work/sony-a7iv/virtual-video.json

# Kernel module build products
*.o
*.ko
*.mod.c
.*.cmd
Module.symvers
modules.order

# Local publishing tools and authentication scratch space
/work/publish-tools/
